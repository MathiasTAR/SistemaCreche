                  <CheckBox fx:id="checkFossa" mnemonicParsing="false" text="Fossa" GridPane.rowIndex="2" />
                  <CheckBox fx:id="checkCifon" mnemonicParsing="false" text="Cifon" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <CheckBox fx:id="checkEnergiaEletrica" mnemonicParsing="false" text="Energia Eletrica" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                  <CheckBox fx:id="checkAguaEncanada" mnemonicParsing="false" text="Agua Encanada" GridPane.columnIndex="3" GridPane.rowIndex="2" />
                    </children>
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" />
                    </rowConstraints>
                </GridPane>
            </VBox>

            <!-- Seção 6: Bens no Domicílio -->
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-border-color: #c8e1e6; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 20;">
                <Label style="-fx-text-fill: #0f766e; -fx-font-weight: bold; -fx-font-size: 16;" text="6. Bens no Domicílio">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <VBox fx:id="containerBens" spacing="10" />
            </VBox>

            <!-- Seção 7: Composição Familiar -->
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-border-color: #c8e1e6; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 20;">
                <Label style="-fx-text-fill: #0f766e; -fx-font-weight: bold; -fx-font-size: 16;" text="7. Composição Familiar">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <VBox spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #0f766e;" text="Lista de moradores da casa:" />
                        <Button onAction="#abrirCadastroMembroFamiliar" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-background-radius: 5;" text="+ Adicionar Morador" />
                    </HBox>

                    <!-- Tabela de composição familiar -->
                    <TableView fx:id="tableComposicaoFamiliar" prefHeight="200">
                        <columns>
                            <TableColumn prefWidth="150" text="Nome">
                                <cellValueFactory>
                                    <PropertyValueFactory property="nome" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="80" text="Idade">
                                <cellValueFactory>
                                    <PropertyValueFactory property="idade" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="120" text="Parentesco">
                                <cellValueFactory>
                                    <PropertyValueFactory property="parentesco" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="120" text="Escolaridade">
                                <cellValueFactory>
                                    <PropertyValueFactory property="escolaridade" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="120" text="Emprego">
                                <cellValueFactory>
                                    <PropertyValueFactory property="emprego" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="193.60009765625" text="Renda (R$)">
                                <cellValueFactory>
                                    <PropertyValueFactory property="renda" />
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- Seção 8: Série que irá cursar -->
            <VBox prefHeight="168.0" prefWidth="856.0" spacing="15.0" style="-fx-background-color: white; -fx-border-color: #c8e1e6; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 20;">
                <Label style="-fx-text-fill: #0f766e; -fx-font-weight: bold; -fx-font-size: 16;" text="8. Série que irá cursar">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>
                <HBox prefHeight="100.0" prefWidth="200.0">
                    <children>
                        <VBox prefHeight="100.0" prefWidth="422.0" spacing="3">
                            <Label style="-fx-text-fill: #0f766e; -fx-font-size: 12;" text="Ano/Série" />
                            <ComboBox fx:id="comboSerie" prefHeight="35.0" prefWidth="343.0" style="-fx-background-color: white; -fx-border-color: #c8e1e6; -fx-border-radius: 5; -fx-background-radius: 5;" />
                        </VBox>
                        <VBox spacing="3">
                            <children>
                                <Label style="-fx-text-fill: #0f766e; -fx-font-size: 12;" text="Ano Letivo" />
                                <TextField fx:id="fieldAnoLetivo" prefHeight="34.0" prefWidth="346.0" />
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </VBox>

            <!-- Seção 9: Pessoas Autorizadas -->
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-border-color: #c8e1e6; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 20;">
                <Label style="-fx-text-fill: #0f766e; -fx-font-weight: bold; -fx-font-size: 16;" text="9. Pessoas Autorizadas a Retirar a Criança">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <VBox spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-text-fill: #0f766e;" text="Lista de pessoas autorizadas:" />
                        <Button onAction="#abrirCadastroPessoaAutorizada" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-background-radius: 5;" text="+ Adicionar Pessoa" />
                    </HBox>

                    <!-- Tabela de pessoas autorizadas -->
                    <TableView fx:id="tablePessoasAutorizadas" prefHeight="150">
                        <columns>
                            <TableColumn prefWidth="150" text="Nome">
                                <cellValueFactory>
                                    <PropertyValueFactory property="nome" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="120" text="Parentesco">
                                <cellValueFactory>
                                    <PropertyValueFactory property="parentesco" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="120" text="RG">
                                <cellValueFactory>
                                    <PropertyValueFactory property="rg" />
                                </cellValueFactory>
                            </TableColumn>
                            <TableColumn prefWidth="120" text="Telefone">
                                <cellValueFactory>
                                    <PropertyValueFactory property="telefone" />
                                </cellValueFactory>
                            </TableColumn>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>

            <!-- Seção 10: Declaração -->
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-border-color: #c8e1e6; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 20;">
                <Label style="-fx-text-fill: #0f766e; -fx-font-weight: bold; -fx-font-size: 16;" text="10. Declaração">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <VBox spacing="10">
                    <Label style="-fx-text-fill: #0f766e; -fx-font-size: 12;" text="Anexar Declaração de Matrícula" />
                    <Button style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-width: 150;" text="Importar Anexo" />
                </VBox>
            </VBox>

            <!-- Seção 11: Irmãos e Gêmeos -->
            <VBox spacing="15.0" style="-fx-background-color: white; -fx-border-color: #c8e1e6; -fx-border-width: 1; -fx-border-radius: 5; -fx-padding: 20;">
                <Label style="-fx-text-fill: #0f766e; -fx-font-weight: bold; -fx-font-size: 16;" text="11. Irmãos e Gêmeos">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <VBox spacing="10">
                    <Label style="-fx-text-fill: #666; -fx-font-size: 12;" text="O sistema detecta automaticamente irmãos quando os pais são os mesmos." />

                    <!-- Container para irmãos encontrados -->
                    <VBox fx:id="containerIrmaos" spacing="8" />
                </VBox>
            </VBox>

            <!-- Botões de ação -->
            <HBox alignment="CENTER_RIGHT" spacing="10.0" style="-fx-padding: 10 10 0 10;">
                <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#salvarPreMatricula" style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-width: 150; -fx-pref-height: 35;" text="Salvar Matrícula" />
                <Button fx:id="btnCancelar" mnemonicParsing="false" onAction="#cancelarCadastro" style="-fx-background-color: #b02e50; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-width: 100; -fx-pref-height: 35;" text="Cancelar" />
            </HBox>
        </VBox>
    </ScrollPane>
</VBox>
